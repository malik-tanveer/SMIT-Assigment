    "1. Create a class 'BankAccount' with attributes account holder name, account number, and\n",
    "balance. Add methods for deposit and withdrawal. Implement logic to prevent withdrawal if balance\n",
    "is insufficient."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "9e1786bd-6bcd-47c0-8787-24560abd6c13",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Bankaccount:\n",
    "    def __init__(self, name, account_no, balance):\n",
    "        self.name = name\n",
    "        self.account_no = account_no\n",
    "        self.balance = balance\n",
    "\n",
    "    def deposit(self, amount):\n",
    "        self.balance += amount\n",
    "        print(\"Deposit\")\n",
    "\n",
    "    def withdraw(self,amount):\n",
    "        if amount <= self.balance:\n",
    "            self.balance -= amount\n",
    "        else:\n",
    "            print(\"Insufficient balance\")\n",
    "\n",
    "    def balance_chck(self):\n",
    "        print(f\"\"\"you bank account no : {self.account_no} Total Balance in Your Account {self.balance}\"\"\")"
   ]
  },
