   "source": [
    "3. Create a class 'ElectricityBill' for a KE-electric consumer. Include units consumed and calculate\n",
    "bill based on slab rates (e.g., different price per unit for different ranges)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "72853e43-8e8e-4be7-b74b-070462c1fd98",
   "metadata": {},
   "outputs": [],
   "source": [
    "class ElectricityBill:\n",
    "    def __init__(self, name, units):\n",
    "        self.name = name\n",
    "        self.units = units\n",
    "\n",
    "    def cal_bill(self):\n",
    "        units = self.units\n",
    "        bill = 0\n",
    "        \n",
    "        if units <= 100:\n",
    "            bill = units * 5\n",
    "        elif units <= 300:\n",
    "            bill = 100 * 5 + (units - 100) * 8\n",
    "        elif units <= 700:\n",
    "            bill = 100 * 5 + 200 * 8 + (units - 300) * 12\n",
    "        else:\n",
    "            bill = 100 * 5 + 200 * 8 + 400 * 12 + (units - 700) * 18\n",
    "        return bill\n",
    "\n",
    "    def display_bill(self):\n",
    "        print(\"Units Consumed:\", self.units)\n",
    "        print(\"Total Bill: Rs.\", self.cal_bill())"
   ]
  },
