    "9. Create a class 'MobilePhone' with private attribute battery percentage. Use getter and setter\n",
    "methods to update battery with validation (0–100 only)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "642edf9b-137c-4b19-8091-f8615f7233b7",
   "metadata": {},
   "outputs": [],
   "source": [
    "class mobilephone:\n",
    "    def __init__(self, battery):\n",
    "        self._battery = battery\n",
    "\n",
    "    def get_battery(self):\n",
    "        return self._battery\n",
    "\n",
    "    def set_battery(self, battery):\n",
    "        if battery >= 0 and battery <= 100:\n",
    "            self._battery = battery\n",
    "        else:\n",
    "            print(\"Battery percentage must be 0 and 100\")"
   ]
