   "cell_type": "code",
   "execution_count": 2,
   "id": "f310285b-b220-46ab-8c92-2a443dde3db5",
   "metadata": {},
   "outputs": [],
   "source": [
    "class hospitapatient:\n",
    "    def __init__(self, name, age, disease):\n",
    "        self.name = name\n",
    "        self.age = age\n",
    "        self.disease = disease\n",
    "\n",
    "    def proitority(self):\n",
    "         if self.age > 60:\n",
    "             return \"Emergency\"\n",
    "         elif self.disease == \"Heart Attack\":\n",
    "            return \"Emergency\"\n",
    "         elif self.disease == \"Stroke\":\n",
    "            return \"Emergency\"\n",
    "         elif self.disease == \"Cancer\":\n",
    "            return \"Emergency\"\n",
    "         else:\n",
    "             return \"Normal\""
