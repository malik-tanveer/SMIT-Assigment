    "5. Create a class 'Employee' with basic salary. Add a method to calculate total salary including\n",
    "bonus (10%) and tax deduction (5%)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 73,
   "id": "4088e0a6-aa3f-4bf8-b109-9dcae84fdf99",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Employee:\n",
    "    def __init__(self,name,salary):\n",
    "        self.name = name\n",
    "        self.salary = salary\n",
    "\n",
    "    def bonus(self):\n",
    "        return self.salary * 0.10\n",
    "\n",
    "    def tax (self):\n",
    "        return self.salary * 0.5\n",
    "\n",
    "    def total_salary(self):\n",
    "        total = self.salary + self.bonus() - self.tax()\n",
    "        return total"
   ]
